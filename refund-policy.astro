.card{display:block;padding:20px;background:var(--surface);border:1px solid var(--line2);border-radius:14px;color:inherit}
a.card:hover{border-color:var(--accent);color:inherit}
.card svg{stroke:var(--accent);margin-bottom:12px;display:block}
.card h3{font-size:17px;margin-bottom:6px}
.card p{font-size:14px;color:var(--muted)}
a.card h3::after{content:" →";color:var(--ink)}

.table-wrap{overflow-x:auto;border:1px solid var(--line2);border-radius:14px}
table{width:100%;border-collapse:collapse;font-size:14px;min-width:560px}
th,td{text-align:left;padding:13px 16px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-family:var(--mono);font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--dim);background:var(--bg2);font-weight:500}
tr:last-child td{border-bottom:0}
td{color:var(--soft)}
td:first-child{color:#fff;font-weight:600}
.pop{font-family:var(--mono);font-size:11px;padding:2px 8px;border-radius:999px;background:var(--accent);color:#fff;margin-left:6px;font-weight:500;vertical-align:1px}

.steps{list-style:none;padding:0;margin:0;counter-reset:s}
.steps li{counter-increment:s;position:relative;padding:0 0 22px 52px;color:var(--soft)}
.steps li::before{content:counter(s);position:absolute;left:0;top:-2px;width:34px;height:34px;border-radius:50%;background:var(--tint);border:1px solid var(--accent);color:#fff;font:600 14px/32px var(--mono);text-align:center}
.steps li:not(:last-child)::after{content:"";position:absolute;left:17px;top:36px;bottom:4px;width:1px;background:var(--line2)}
.steps strong{color:#fff}

.note{display:flex;gap:14px;margin-top:40px;padding:16px 18px;border:1px solid #2F2A5C;background:var(--tint);border-radius:14px;color:var(--soft);font-size:15px}
.note svg{flex:none;stroke:var(--ink);margin-top:2px}

.pager{display:flex;justify-content:flex-end;margin-top:56px;padding-top:24px;border-top:1px solid var(--line)}
.pager a{display:block;padding:14px 18px;border:1px solid var(--line2);border-radius:12px;text-align:right;color:var(--text)}
.pager a:hover{border-color:var(--accent)}
.pager small{display:block;font-size:12px;color:var(--dim)}

.toc{position:sticky;top:64px;align-self:start;padding:40px 0}
.toc-title{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);margin-bottom:12px}
.toc a{display:block;font-size:13px;color:var(--dim);padding:5px 0 5px 12px;border-left:1px solid var(--line2)}
.toc a:hover{color:#fff}
.toc a.active{color:#fff;border-left-color:var(--accent)}

footer{border-top:1px solid var(--line);color:var(--dim);font-size:13px}
.foot-in{max-width:1440px;margin:0 auto;padding:22px 24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px}
footer a{color:var(--soft)}

@media (max-width:1180px){
  .layout{grid-template-columns:240px minmax(0,1fr)}
