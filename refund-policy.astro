@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
.list{margin:0 0 8px;padding-left:20px;color:var(--soft)}
.list li{margin-bottom:12px;padding-left:4px}
.list li::marker{color:var(--ink)}
.list strong{color:#fff}
.updated{margin-top:32px;font-size:13px;color:var(--dim);font-style:italic}
