*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.65}
a{color:var(--ink);text-decoration:none}
a:hover{color:#fff}
a:focus-visible,summary:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
h1,h2,h3{font-family:var(--display);color:#fff;margin:0}
p{margin:0}
code{font-family:var(--mono);font-size:.88em;background:#161E28;border:1px solid var(--line2);border-radius:6px;padding:1px 6px;color:#E6EBF0}

/* top bar */
.top{position:sticky;top:0;z-index:20;background:rgba(10,14,19,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.top-in{max-width:1440px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:12px}
.brand img{display:block;height:34px;width:auto}
.brand span{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;color:var(--dim);border-left:1px solid var(--line2);padding-left:12px}
.top-links{display:flex;flex-wrap:wrap;align-items:center;gap:8px 20px;font-size:14px;font-weight:500}
.top-links a{color:var(--soft)}
.top-links a:hover{color:#fff}
.btn{display:inline-block;padding:9px 16px;border-radius:10px;font-weight:600;font-size:14px}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#5D4BEA;color:#fff}

/* layout */
.layout{max-width:1440px;margin:0 auto;display:grid;grid-template-columns:260px minmax(0,1fr) 220px;gap:48px;padding:0 24px}
.side{position:sticky;top:64px;align-self:start;height:calc(100vh - 64px);overflow-y:auto;padding:32px 0}
.group{margin-bottom:28px}
.group-title{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);margin-bottom:10px}
.side a{display:block;padding:7px 12px;margin-left:-12px;border-radius:8px;font-size:14px;color:var(--soft)}
.side a:hover{background:var(--surface);color:#fff}
.side a[aria-current="page"]{background:var(--tint);color:#fff;font-weight:600;box-shadow:inset 2px 0 0 var(--accent)}
.side .ext::after{content:" ↗";color:var(--dim)}
.mobile-nav{display:none}

main{padding:40px 0 88px;min-width:0;max-width:800px}
.crumb{font-family:var(--mono);font-size:13px;color:var(--ink);margin-bottom:10px}
h1{font-size:44px;line-height:1.1;letter-spacing:-1px;margin-bottom:14px}
.lead{font-size:19px;color:var(--muted);margin-bottom:28px}
.prose p{color:var(--soft);margin-bottom:16px}
