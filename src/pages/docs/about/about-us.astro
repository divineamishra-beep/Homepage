<style is:global>
:root{
  --bg:#0A0E13; --bg2:#0D1218; --surface:#11171F; --line:#1C2530; --line2:#222C38;
  --text:#E6EBF0; --soft:#C9D2DC; --muted:#A7B3C0; --dim:#93A1B0;
  --accent:#6E5CF6; --ink:#A89DFA; --tint:#16132B;
  --display:"Space Grotesk",Inter,system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.65}
a{color:var(--ink);text-decoration:none}
a:hover{color:#fff}
a:focus-visible,summary:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
h1,h2,h3{font-family:var(--display);color:#fff;margin:0}
p{margin:0}
code{font-family:var(--mono);font-size:.88em;background:#161E28;border:1px solid var(--line2);border-radius:6px;padding:1px 6px;color:#E6EBF0}

/* top bar */
.top{position:sticky;top:0;z-index:20;background:rgba(10,14,19,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.top-in{max-width:1440px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:12px}
.brand img{display:block;height:34px;width:auto}
.brand span{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;color:var(--dim);border-left:1px solid var(--line2);padding-left:12px}
.top-links{display:flex;flex-wrap:wrap;align-items:center;gap:8px 20px;font-size:14px;font-weight:500}
.top-links a{color:var(--soft)}
.top-links a:hover{color:#fff}
.btn{display:inline-block;padding:9px 16px;border-radius:10px;font-weight:600;font-size:14px}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#5D4BEA;color:#fff}

/* layout */
.layout{max-width:1440px;margin:0 auto;display:grid;grid-template-columns:260px minmax(0,1fr) 220px;gap:48px;padding:0 24px}
.side{position:sticky;top:64px;align-self:start;height:calc(100vh - 64px);overflow-y:auto;padding:32px 0}
.group{margin-bottom:28px}
.group-title{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);margin-bottom:10px}
.side a{display:block;padding:7px 12px;margin-left:-12px;border-radius:8px;font-size:14px;color:var(--soft)}
.side a:hover{background:var(--surface);color:#fff}
.side a[aria-current="page"]{background:var(--tint);color:#fff;font-weight:600;box-shadow:inset 2px 0 0 var(--accent)}
.side .ext::after{content:" ↗";color:var(--dim)}
.mobile-nav{display:none}

main{padding:40px 0 88px;min-width:0;max-width:800px}
.crumb{font-family:var(--mono);font-size:13px;color:var(--ink);margin-bottom:10px}
h1{font-size:44px;line-height:1.1;letter-spacing:-1px;margin-bottom:14px}
.lead{font-size:19px;color:var(--muted);margin-bottom:28px}
.prose p{color:var(--soft);margin-bottom:16px}
.prose strong{color:#fff;font-weight:600}
h2{font-size:28px;letter-spacing:-.5px;margin:56px 0 18px;padding-top:4px}
h2 a.anchor{color:inherit}
h2 a.anchor:hover::after{content:" #";color:var(--dim)}

.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.card{display:block;padding:20px;background:var(--surface);border:1px solid var(--line2);border-radius:14px;color:inherit}
a.card:hover{border-color:var(--accent);color:inherit}
.card svg{stroke:var(--accent);margin-bottom:12px;display:block}
.card h3{font-size:17px;margin-bottom:6px}
.card p{font-size:14px;color:var(--muted)}
a.card h3::after{content:" →";color:var(--ink)}

.table-wrap{overflow-x:auto;border:1px solid var(--line2);border-radius:14px}
table{width:100%;border-collapse:collapse;font-size:14px;min-width:560px}
th,td{text-align:left;padding:13px 16px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-family:var(--mono);font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--dim);background:var(--bg2);font-weight:500}
tr:last-child td{border-bottom:0}
td{color:var(--soft)}
td:first-child{color:#fff;font-weight:600}
.pop{font-family:var(--mono);font-size:11px;padding:2px 8px;border-radius:999px;background:var(--accent);color:#fff;margin-left:6px;font-weight:500;vertical-align:1px}

.steps{list-style:none;padding:0;margin:0;counter-reset:s}
.steps li{counter-increment:s;position:relative;padding:0 0 22px 52px;color:var(--soft)}
.steps li::before{content:counter(s);position:absolute;left:0;top:-2px;width:34px;height:34px;border-radius:50%;background:var(--tint);border:1px solid var(--accent);color:#fff;font:600 14px/32px var(--mono);text-align:center}
.steps li:not(:last-child)::after{content:"";position:absolute;left:17px;top:36px;bottom:4px;width:1px;background:var(--line2)}
.steps strong{color:#fff}

.note{display:flex;gap:14px;margin-top:40px;padding:16px 18px;border:1px solid #2F2A5C;background:var(--tint);border-radius:14px;color:var(--soft);font-size:15px}
.note svg{flex:none;stroke:var(--ink);margin-top:2px}

.pager{display:flex;justify-content:flex-end;margin-top:56px;padding-top:24px;border-top:1px solid var(--line)}
.pager a{display:block;padding:14px 18px;border:1px solid var(--line2);border-radius:12px;text-align:right;color:var(--text)}
.pager a:hover{border-color:var(--accent)}
.pager small{display:block;font-size:12px;color:var(--dim)}

.toc{position:sticky;top:64px;align-self:start;padding:40px 0}
.toc-title{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);margin-bottom:12px}
.toc a{display:block;font-size:13px;color:var(--dim);padding:5px 0 5px 12px;border-left:1px solid var(--line2)}
.toc a:hover{color:#fff}
.toc a.active{color:#fff;border-left-color:var(--accent)}

footer{border-top:1px solid var(--line);color:var(--dim);font-size:13px}
.foot-in{max-width:1440px;margin:0 auto;padding:22px 24px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px}
footer a{color:var(--soft)}

@media (max-width:1180px){
  .layout{grid-template-columns:240px minmax(0,1fr)}
  .toc{display:none}
}
@media (max-width:860px){
  .layout{grid-template-columns:minmax(0,1fr);gap:0}
  .side{display:none}
  .mobile-nav{display:block;margin:20px 0 0;border:1px solid var(--line2);border-radius:12px;background:var(--surface)}
  .mobile-nav summary{cursor:pointer;padding:12px 16px;font-weight:600;font-size:14px;list-style:none}
  .mobile-nav summary::after{content:" ▾";color:var(--dim)}
  .mobile-nav .inner{padding:4px 16px 12px}
  .mobile-nav a{display:block;padding:7px 0;color:var(--soft);font-size:14px}
  .top-links .hide-sm{display:none}
  h1{font-size:34px}
  h2{font-size:24px}
  main{padding-top:24px}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
.list{margin:0 0 8px;padding-left:20px;color:var(--soft)}
.list li{margin-bottom:12px;padding-left:4px}
.list li::marker{color:var(--ink)}
.list strong{color:#fff}
.updated{margin-top:32px;font-size:13px;color:var(--dim);font-style:italic}
</style>
</head>
