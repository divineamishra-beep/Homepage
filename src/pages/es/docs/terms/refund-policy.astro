.lang-select{appearance:none;-webkit-appearance:none;height:28px;padding:0 10px;border-radius:999px;border:1px solid var(--line2);background:var(--bg2);color:var(--text);font:600 12px/1 inherit;cursor:pointer;margin-right:8px;vertical-align:middle}
.lang-select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
