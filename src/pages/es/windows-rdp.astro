<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{--white:#fff;--wrgb:255,255,255;
  --bg:#0A0E13; --bg2:#0D1218; --surface:#11171F; --line:#1C2530; --line2:#222C38; --line3:#2A3646;
  --text:#E6EBF0; --soft:#C9D2DC; --muted:#A7B3C0; --dim:#93A1B0;
  --accent:#6E5CF6; --ink:#A89DFA; --popular:#16132B;
  --display:"Space Grotesk",Inter,system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;
}
html[data-theme="light"]{--bg:#FFFFFF;--bg2:#F5F7FA;--surface:#FFFFFF;--line:#E3E8EF;--line2:#D6DDE6;--line3:#C5CED9;--text:#1E2733;--soft:#344150;--muted:#566475;--dim:#6B7888;--accent:#6E5CF6;--ink:#5847E0;--popular:#F2EFFF;--tint:#F2EFFF;--none:#D5DBE3;--white:#0A0E13;--wrgb:10,14,19;color-scheme:light}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.55}
a{color:var(--text);text-decoration:none}
a:hover{color:var(--white)}
a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
h1,h2,h3{margin:0;font-family:var(--display);color:var(--white)}
p{margin:0}
.wrap{max-width:1200px;margin:0 auto;padding-left:24px;padding-right:24px}
.alt{background:var(--bg2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.eyebrow{font-family:var(--mono);font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--ink)}
.h2{margin:10px 0 44px;font-weight:700;font-size:46px;line-height:1.1;letter-spacing:-1px;max-width:680px}
.lead{font-size:17px;color:var(--muted)}
.btn{display:inline-block;padding:15px 24px;font-weight:600;border-radius:12px;text-align:center}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#5D4BEA;color:#fff}
.btn-outline{border:1.5px solid var(--accent);color:var(--text)}
.dot{width:10px;height:10px;border-radius:50%;background:var(--accent);display:inline-block}

/* nav */
header{border-bottom:1px solid var(--line)}
.nav{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-top:16px;padding-bottom:16px}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:700;font-size:22px;letter-spacing:.5px;color:var(--white)}
.nav nav{display:flex;flex-wrap:wrap;gap:6px 26px;font-size:15px;font-weight:500}
.nav nav a{color:var(--soft);padding:10px 0}
.nav-actions{display:flex;gap:10px;align-items:center}
.nav-actions a{padding:11px 16px;font-size:15px;border-radius:10px}

/* hero */
.hero{display:flex;flex-wrap:wrap;gap:56px;align-items:center;padding-top:88px;padding-bottom:72px}
.hero-copy{flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:24px}
.pill{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;padding:6px 12px;border:1px solid #263140;border-radius:999px;font-family:var(--mono);font-size:13px;color:var(--soft)}
.pill .dot{width:8px;height:8px}
.hero h1{font-weight:700;font-size:64px;line-height:1.04;letter-spacing:-1.5px}
.hero-sub{font-size:19px;color:var(--muted);max-width:560px}
.ctas{display:flex;flex-wrap:wrap;gap:12px}
.hero-meta{display:flex;flex-wrap:wrap;gap:10px 22px;padding-top:8px;font-size:14px;color:var(--dim)}
.hero-meta strong{color:var(--white);font-weight:600}
.panel{flex:1 1 420px;min-width:0;max-width:520px;background:var(--surface);border:1px solid var(--line2);border-radius:18px;overflow:hidden}
.panel-head{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line)}
.panel-host{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:14px;color:var(--white)}
.badge{font-family:var(--mono);font-size:12px;padding:4px 10px;border-radius:999px;background:#1B1838;color:var(--ink)}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line)}
.facts div{background:var(--surface);padding:16px 20px}
.facts small{display:block;font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:1px}
.facts span{font-family:var(--mono);font-size:15px;color:var(--white)}
.chart{padding:18px 20px 8px}
.chart-label{display:flex;justify-content:space-between;font-size:13px;color:var(--dim)}
.bars{display:flex;align-items:flex-end;gap:5px;height:72px;padding-top:12px}
.bars i{flex:1;background:#24313F;border-radius:3px}
.bars i:last-child{background:var(--accent)}
.term{margin:12px 20px 20px;padding:14px 16px;background:var(--bg);border:1px solid var(--line);border-radius:12px;font-family:var(--mono);font-size:13px;line-height:1.8;color:var(--muted)}
.term b{color:var(--ink);font-weight:400}
.cursor{display:inline-block;width:8px;height:15px;vertical-align:-2px;background:var(--text);animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* os strip */
.os img{display:block;width:30px;height:30px;opacity:.85;transition:opacity .15s,transform .15s}
.os img:hover{opacity:1;transform:translateY(-2px)}
@media (prefers-reduced-motion:reduce){.os img{transition:none}.os img:hover{transform:none}}
.os{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px 28px;padding-top:22px;padding-bottom:22px;font-family:var(--mono);font-size:14px;color:var(--muted)}

/* grids */
.grid{display:grid;gap:18px}
.uses{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;padding-top:80px;padding-bottom:24px}
.use{padding:20px;border:1px solid var(--line);border-radius:14px}
.use h3{font-size:17px}
.use p{font-size:14px;color:var(--dim);margin-top:6px}

/* pricing */
.pricing{padding-top:80px;padding-bottom:80px}
.pricing-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:36px}
.pricing-head .h2{margin-bottom:12px;max-width:620px}
.toggle{display:flex;padding:4px;background:var(--surface);border:1px solid var(--line2);border-radius:12px}
.toggle button{min-height:44px;padding:10px 18px;border:0;border-radius:9px;font:600 14px Inter,system-ui,sans-serif;cursor:pointer;background:transparent;color:var(--soft)}
.toggle button[aria-pressed="true"]{background:var(--accent);color:#fff}
.plans{grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}
.plan{display:flex;flex-direction:column;gap:16px;padding:22px;background:var(--surface);border:1px solid var(--line2);border-radius:18px}
.plan.popular{background:var(--popular);border:2px solid var(--accent)}
.plan-top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px}
.plan h3{font-size:20px}
.tag{font-family:var(--mono);font-size:11px;padding:4px 9px;border-radius:999px;background:var(--accent);color:#fff;font-weight:500}
.price{font-family:var(--display);font-weight:700;font-size:36px;color:var(--white)}
.per{color:var(--dim)}
.specs{font-size:14px;line-height:2;color:var(--soft);border-top:1px solid var(--line);padding-top:14px}
.popular .specs{border-top-color:#2A2650}
.where{font-size:13px;color:var(--dim)}
.plan .btn{margin-top:auto;padding:13px}
.included{margin-top:20px;display:flex;flex-wrap:wrap;gap:10px 28px;padding:18px 24px;border:1px dashed #263140;border-radius:14px;font-size:14px;color:var(--muted)}
.included strong{color:var(--white);font-weight:600}

/* cards */
.section{padding-top:88px;padding-bottom:88px}
.steps{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.card{padding:28px;background:var(--surface);border:1px solid var(--line2);border-radius:18px}
.card .num{font-family:var(--mono);font-size:14px;color:var(--ink)}
.card h3{margin:14px 0 8px;font-size:22px}
.card p,.feature p{color:var(--muted)}
.features{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.feature{padding:28px;border:1px solid var(--line);border-radius:18px;display:flex;flex-direction:column;gap:12px}
.feature h3{font-size:21px}
.feature svg{stroke:var(--accent)}

/* locations */
.locations{display:flex;flex-wrap:wrap;gap:48px;align-items:center}
.locations > div:first-child{flex:1 1 380px;min-width:0}
.locations .h2{margin-bottom:14px}
.dc{flex:1 1 520px;min-width:0;padding:26px;background:var(--surface);border:1px solid var(--line2);border-radius:18px;display:flex;flex-direction:column;gap:14px}
.dc-name{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:700;font-size:22px;color:var(--white)}
.dc-sub{font-size:14px;color:var(--dim)}
.dc-specs{font-family:var(--mono);font-size:13px;line-height:1.9;color:var(--soft);border-top:1px solid var(--line);padding-top:12px}
.dc a{font-weight:600;color:var(--ink)}

/* faq */
.faq{max-width:860px;margin:0 auto;padding:88px 24px}
.faq .eyebrow,.faq .h2{text-align:center;margin-left:auto;margin-right:auto}
.faq .h2{margin-bottom:40px}
.faq-list{border-top:1px solid var(--line)}
.faq-item{border-bottom:1px solid var(--line)}
.faq-item button{width:100%;min-height:64px;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 4px;background:none;border:0;color:var(--white);font:600 18px Inter,system-ui,sans-serif;text-align:left;cursor:pointer}
.faq-item .plus{font-size:24px;line-height:1;color:var(--ink);transition:transform .2s}
.faq-item button[aria-expanded="true"] .plus{transform:rotate(45deg)}
.faq-item p{padding:0 4px 22px;color:var(--muted)}

/* cta */
.cta-wrap{padding-bottom:88px}
.cta{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:28px;padding:48px;background:var(--accent);border-radius:24px;color:var(--white)}
.cta > div:first-child{flex:1 1 420px;min-width:0}
.cta h2{margin-bottom:8px;font-weight:700;font-size:40px;line-height:1.1;letter-spacing:-1px}
.cta p{font-size:17px}
.btn-white{background:var(--white);color:#3F2FC4}
.btn-white:hover{color:#2A1DA0}
.btn-ghost{border:1.5px solid var(--white);color:var(--white)}

/* footer */
footer{border-top:1px solid var(--line);background:var(--bg2)}
.foot{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:32px;padding-top:56px}
.foot > div{display:flex;flex-direction:column;gap:10px;font-size:14px}
.foot .logo{font-size:20px}
.foot p{color:var(--dim)}
.foot a{color:var(--soft)}
.foot-title{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;color:var(--dim)}
.copy{margin-top:44px;padding:22px 0 28px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;font-size:13px;color:var(--dim)}

@media (max-width:640px){
  .hero{padding-top:56px}
  .hero h1{font-size:42px}
  .h2{font-size:34px}
  .cta{padding:32px}
  .cta h2{font-size:30px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .cursor{animation:none}
  .faq-item .plus{transition:none}
}

/* phones */
.menu-btn{display:none}
@media (max-width:860px){
  .menu-btn{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid var(--line2);border-radius:10px;background:transparent;color:var(--white);cursor:pointer}
  .nav{gap:12px;padding-top:12px;padding-bottom:12px}
  .nav nav,.nav .nav-actions{display:none;width:100%}
  .nav.open nav{display:flex;flex-direction:column;gap:0;border-top:1px solid var(--line)}
  .nav.open nav a{padding:14px 2px;font-size:16px;border-bottom:1px solid var(--line)}
  .nav.open .nav-actions{display:flex;gap:10px;padding:4px 0 8px}
  .nav.open .nav-actions a{flex:1;text-align:center;padding:13px 12px}
  .logo img{height:34px;width:auto}
}
@media (max-width:640px){
  .wrap{padding-left:20px;padding-right:20px}
  .hero{gap:36px;padding-top:40px;padding-bottom:48px}
  .hero h1{font-size:38px;letter-spacing:-1px}
  .hero-sub{font-size:17px}
  .pill{font-size:12px}
  .ctas .btn{flex:1 1 100%}
  .hero-meta{flex-direction:column;gap:6px}
  .panel{max-width:none}
  .facts div{padding:14px 16px}
  .facts span{font-size:14px}
  .term{font-size:12px;margin:10px 16px 16px}
  .os{justify-content:center;gap:16px 22px}
  .os span:first-child{width:100%;text-align:center}
  .uses{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding-top:56px}
  .use{padding:16px}
  .pricing,.section{padding-top:64px;padding-bottom:64px}
  .h2{font-size:30px;margin-bottom:28px}
  .pricing-head .toggle{width:100%}
