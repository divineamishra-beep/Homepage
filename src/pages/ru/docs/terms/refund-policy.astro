/* lt-fix2 */html[data-theme="light"] .badge{background:#EEEBFF;color:#5847E0}html[data-theme="light"] .pill,html[data-theme="light"] .included{border-color:#D6DDE6}html[data-theme="light"] code{color:#1E2733}
