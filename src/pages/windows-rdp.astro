.bars i:last-child{background:var(--accent)}
.term{margin:12px 20px 20px;padding:14px 16px;background:var(--bg);border:1px solid var(--line);border-radius:12px;font-family:var(--mono);font-size:13px;line-height:1.8;color:var(--muted)}
.term b{color:var(--ink);font-weight:400}
.cursor{display:inline-block;width:8px;height:15px;vertical-align:-2px;background:var(--text);animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* os strip */
.os img{display:block;width:30px;height:30px;opacity:.85;transition:opacity .15s,transform .15s}
.os img:hover{opacity:1;transform:translateY(-2px)}
