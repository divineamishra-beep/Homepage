.faq-item .plus{font-size:24px;line-height:1;color:var(--ink);transition:transform .2s}
.faq-item button[aria-expanded="true"] .plus{transform:rotate(45deg)}
.faq-item p{padding:0 4px 22px;color:var(--muted)}

/* cta */
.cta-wrap{padding-bottom:88px}
.cta{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:28px;padding:48px;background:var(--accent);border-radius:24px;color:#fff}
.cta > div:first-child{flex:1 1 420px;min-width:0}
.cta h2{margin-bottom:8px;font-weight:700;font-size:40px;line-height:1.1;letter-spacing:-1px}
.cta p{font-size:17px}
.btn-white{background:#fff;color:#3F2FC4}
.btn-white:hover{color:#2A1DA0}
.btn-ghost{border:1.5px solid #fff;color:#fff}

/* footer */
footer{border-top:1px solid var(--line);background:var(--bg2)}
.foot{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:32px;padding-top:56px}
