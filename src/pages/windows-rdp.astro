.dc a{font-weight:600;color:var(--ink)}

/* faq */
.faq{max-width:860px;margin:0 auto;padding:88px 24px}
.faq .eyebrow,.faq .h2{text-align:center;margin-left:auto;margin-right:auto}
.faq .h2{margin-bottom:40px}
