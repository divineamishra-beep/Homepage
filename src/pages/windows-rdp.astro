.toggle button[aria-pressed="true"]{background:var(--accent);color:#fff}
.plans{grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}
.plan{display:flex;flex-direction:column;gap:16px;padding:22px;background:var(--surface);border:1px solid var(--line2);border-radius:18px}
