<script is:inline>
(function () {
  var labels = {
    windows: { os: 'Windows 10 / 11', url: 'https://dash.evevps.com/store/windows-rdp' },
    linux:   { os: 'Ubuntu, Debian, AlmaLinux, Rocky + more', url: 'https://dash.evevps.com/store/linux-vps' }
  };
  var buttons = document.querySelectorAll('.toggle button');
  function setProduct(p) {
    buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.set === p)); });
    document.querySelectorAll('.os-label').forEach(function (el) { el.textContent = labels[p].os; });
    document.querySelectorAll('.order').forEach(function (a) { a.href = labels[p].url + '/' + a.dataset.plan; });
  }
  buttons.forEach(function (b) { b.addEventListener('click', function () { setProduct(b.dataset.set); }); });
  document.querySelectorAll('[data-product]').forEach(function (a) {
    a.addEventListener('click', function () { setProduct(a.dataset.product); });
  });

  var items = document.querySelectorAll('.faq-item button');
  items.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      items.forEach(function (o) {
        o.setAttribute('aria-expanded', 'false');
        document.getElementById(o.getAttribute('aria-controls')).hidden = true;
      });
      if (!open) {
        btn.setAttribute('aria-expanded', 'true');
        document.getElementById(btn.getAttribute('aria-controls')).hidden = false;
      }
    });
  });
})();
</script>
<script is:inline>
(function () {
  var b = document.querySelector('.menu-btn');
  if (!b) return;
  var n = b.closest('.nav');
  function set(o) { n.classList.toggle('open', o); b.setAttribute('aria-expanded', String(o)); b.setAttribute('aria-label', o ? 'Close menu' : 'Open menu'); }
  b.addEventListener('click', function () { set(!n.classList.contains('open')); });
  n.querySelectorAll('nav a, .nav-actions a').forEach(function (a) { a.addEventListener('click', function () { set(false); }); });
})();
</script>
