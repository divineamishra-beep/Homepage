<style is:global>
:root{
  --bg:#0A0E13; --bg2:#0D1218; --surface:#11171F; --line:#1C2530; --line2:#222C38; --line3:#2A3646;
  --text:#E6EBF0; --soft:#C9D2DC; --muted:#A7B3C0; --dim:#93A1B0;
  --accent:#6E5CF6; --ink:#A89DFA; --popular:#16132B;
  --display:"Space Grotesk",Inter,system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.55}
a{color:var(--text);text-decoration:none}
a:hover{color:#fff}
a:focus-visible,button:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
h1,h2,h3{margin:0;font-family:var(--display);color:#fff}
p{margin:0}
.wrap{max-width:1200px;margin:0 auto;padding-left:24px;padding-right:24px}
.alt{background:var(--bg2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.eyebrow{font-family:var(--mono);font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--ink)}
.h2{margin:10px 0 44px;font-weight:700;font-size:46px;line-height:1.1;letter-spacing:-1px;max-width:680px}
.lead{font-size:17px;color:var(--muted)}
.btn{display:inline-block;padding:15px 24px;font-weight:600;border-radius:12px;text-align:center}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#5D4BEA;color:#fff}
.btn-outline{border:1.5px solid var(--accent);color:var(--text)}
.dot{width:10px;height:10px;border-radius:50%;background:var(--accent);display:inline-block}

/* nav */
header{border-bottom:1px solid var(--line)}
.nav{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-top:16px;padding-bottom:16px}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:700;font-size:22px;letter-spacing:.5px;color:#fff}
