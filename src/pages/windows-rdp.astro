.plan-top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px}
.plan h3{font-size:20px}
.tag{font-family:var(--mono);font-size:11px;padding:4px 9px;border-radius:999px;background:var(--accent);color:#fff;font-weight:500}
.price{font-family:var(--display);font-weight:700;font-size:36px;color:#fff}
.per{color:var(--dim)}
.specs{font-size:14px;line-height:2;color:var(--soft);border-top:1px solid var(--line);padding-top:14px}
.popular .specs{border-top-color:#2A2650}
.where{font-size:13px;color:var(--dim)}
.plan .btn{margin-top:auto;padding:13px}
.included{margin-top:20px;display:flex;flex-wrap:wrap;gap:10px 28px;padding:18px 24px;border:1px dashed #263140;border-radius:14px;font-size:14px;color:var(--muted)}
.included strong{color:#fff;font-weight:600}

/* cards */
.section{padding-top:88px;padding-bottom:88px}
.steps{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.card{padding:28px;background:var(--surface);border:1px solid var(--line2);border-radius:18px}
.card .num{font-family:var(--mono);font-size:14px;color:var(--ink)}
.card h3{margin:14px 0 8px;font-size:22px}
.card p,.feature p{color:var(--muted)}
.features{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.feature{padding:28px;border:1px solid var(--line);border-radius:18px;display:flex;flex-direction:column;gap:12px}
.feature h3{font-size:21px}
.feature svg{stroke:var(--accent)}

/* locations */
.locations{display:flex;flex-wrap:wrap;gap:48px;align-items:center}
.locations > div:first-child{flex:1 1 380px;min-width:0}
.locations .h2{margin-bottom:14px}
.dc{flex:1 1 520px;min-width:0;padding:26px;background:var(--surface);border:1px solid var(--line2);border-radius:18px;display:flex;flex-direction:column;gap:14px}
.dc-name{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:700;font-size:22px;color:#fff}
.dc-sub{font-size:14px;color:var(--dim)}
