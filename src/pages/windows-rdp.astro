.os{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px 28px;padding-top:22px;padding-bottom:22px;font-family:var(--mono);font-size:14px;color:var(--muted)}

/* grids */
.grid{display:grid;gap:18px}
.uses{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;padding-top:80px;padding-bottom:24px}
.use{padding:20px;border:1px solid var(--line);border-radius:14px}
.use h3{font-size:17px}
.use p{font-size:14px;color:var(--dim);margin-top:6px}

