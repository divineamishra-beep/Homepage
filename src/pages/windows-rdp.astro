.nav-actions{display:flex;gap:10px;align-items:center}
.nav-actions a{padding:11px 16px;font-size:15px;border-radius:10px}

/* hero */
.hero{display:flex;flex-wrap:wrap;gap:56px;align-items:center;padding-top:88px;padding-bottom:72px}
.hero-copy{flex:1 1 480px;min-width:0;display:flex;flex-direction:column;gap:24px}
.pill{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;padding:6px 12px;border:1px solid #263140;border-radius:999px;font-family:var(--mono);font-size:13px;color:var(--soft)}
.pill .dot{width:8px;height:8px}
.hero h1{font-weight:700;font-size:64px;line-height:1.04;letter-spacing:-1.5px}
.hero-sub{font-size:19px;color:var(--muted);max-width:560px}
.ctas{display:flex;flex-wrap:wrap;gap:12px}
.hero-meta{display:flex;flex-wrap:wrap;gap:10px 22px;padding-top:8px;font-size:14px;color:var(--dim)}
.hero-meta strong{color:#fff;font-weight:600}
.panel{flex:1 1 420px;min-width:0;max-width:520px;background:var(--surface);border:1px solid var(--line2);border-radius:18px;overflow:hidden}
.panel-head{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line)}
.panel-host{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:14px;color:#fff}
.badge{font-family:var(--mono);font-size:12px;padding:4px 10px;border-radius:999px;background:#1B1838;color:var(--ink)}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line)}
.facts div{background:var(--surface);padding:16px 20px}
.facts small{display:block;font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:1px}
.facts span{font-family:var(--mono);font-size:15px;color:#fff}
.chart{padding:18px 20px 8px}
.chart-label{display:flex;justify-content:space-between;font-size:13px;color:var(--dim)}
.bars{display:flex;align-items:flex-end;gap:5px;height:72px;padding-top:12px}
